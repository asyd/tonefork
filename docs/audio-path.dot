// Render: dot -Tsvg audio-path.dot -o audio-path.svg
digraph audio_path {
  rankdir=TB;
  fontname="Helvetica"; fontsize=12;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#f4f4f4", color="#888888"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  compound=true;

  subgraph cluster_app {
    label="Applications (user space)"; style="rounded,filled"; fillcolor="#eaf3ff"; color="#7aa7e0";
    tonefork [label="tonefork\n(generates samples, f32, -40 dBFS RMS)", fillcolor="#ffffff"];
    cpal_pulse [label="cpal — PulseAudio host\n(default: talks the PulseAudio protocol)", fillcolor="#ffffff"];
    cpal_alsa [label="cpal — ALSA host\n(--host alsa)", fillcolor="#ffffff"];
    libasound [label="libasound (ALSA library)\nPCM plugins: default → pulse", fillcolor="#ffffff"];
    rmediy [label="rmediy-rs\n(SysEx over MIDI — control only,\nno audio)", fillcolor="#fff3d6", color="#d9a441"];
    midir [label="midir → ALSA rawmidi", fillcolor="#fff3d6", color="#d9a441"];
  }

  subgraph cluster_server {
    label="Sound server (user space)"; style="rounded,filled"; fillcolor="#eafaf0"; color="#6cc08b";
    pwpulse [label="pipewire-pulse\n(PulseAudio server emulation, unix socket)", fillcolor="#ffffff"];
    graph_ [label="PipeWire graph (1.6.8)\nstream node → mixing / resampling to the sink rate\n→ sink volume (currently 60 % = -13.3 dB)", fillcolor="#ffffff"];
    sink [label="ALSA sink node\nalsa_output.usb-RME_ADI-2_DAC…analog-stereo\n(opens ALSA device front:4)", fillcolor="#ffffff"];
  }

  subgraph cluster_kernel {
    label="Linux kernel"; style="rounded,filled"; fillcolor="#fdeeee"; color="#d98a8a";
    sndusb [label="ALSA core + snd-usb-audio\nPCM: S32_LE, 2 ch, 48 kHz, mmap\nperiod 512 frames, buffer 32768 frames", fillcolor="#ffffff"];
    usbmidi [label="snd-usb-audio MIDI\n(hw:4,0,0)", fillcolor="#fff3d6", color="#d9a441"];
    xhci [label="USB host controller (xHCI)", fillcolor="#ffffff"];
  }

  // One physical cable: audio and MIDI travel together and are separated inside the DAC.
  cable [label="ONE USB cable\n(audio + MIDI share it)", shape=box, style="filled", fillcolor="#e8e8e8", color="#444444", penwidth=2];

  subgraph cluster_dac {
    label="RME ADI-2 DAC"; style="rounded,filled"; fillcolor="#f3eefc"; color="#a48bd6";
    usbif [label="USB interface\n(one device, two functions)", fillcolor="#ffffff"];
    usbrx [label="USB audio class 2 receiver\n(async endpoint + feedback)", fillcolor="#ffffff"];
    dsp [label="Digital processing\nvolume · Parametric EQ · Bass/Treble\nLoudness · Crossfeed · DA filter\n(the settings rmediy-rs changes)", fillcolor="#ffe9b3", color="#d9a441"];
    dac [label="D/A converter", fillcolor="#ffffff"];
    analog [label="Analog stage\nLine out / Phones / IEM", fillcolor="#ffffff"];
    midirx [label="MIDI / SysEx interface", fillcolor="#fff3d6", color="#d9a441"];
  }

  spk [label="Speakers / headphones", shape=box, style="rounded,filled", fillcolor="#dff5df", color="#4c9a4c"];

  // Default audio path
  tonefork -> cpal_pulse;
  cpal_pulse -> pwpulse [label="PulseAudio protocol"];
  pwpulse -> graph_;
  graph_ -> sink;
  sink -> sndusb [label="libasound"];
  sndusb -> xhci;
  xhci -> cable [penwidth=3, color="#444444", dir=both];
  cable -> usbif [penwidth=3, color="#444444", dir=both];
  usbif -> usbrx [label="audio"];
  usbrx -> dsp -> dac -> analog -> spk;

  // Alternative ALSA path
  tonefork -> cpal_alsa [style=dashed, color="#999999"];
  cpal_alsa -> libasound [style=dashed, color="#999999"];
  libasound -> pwpulse [style=dashed, color="#999999", label="'pulse' plugin\n(where the I/O errors\nwere seen)"];
  libasound -> sndusb [style=dashed, color="#999999", label="hw:… direct\n(only if nobody\nholds the device)"];

  // Control path
  rmediy -> midir [color="#d9a441"];
  midir -> usbmidi [color="#d9a441"];
  usbmidi -> xhci [color="#d9a441"];
  usbif -> midirx [color="#d9a441", label="MIDI"];
  midirx -> dsp [color="#d9a441", label="SysEx: set / status", dir=both];
}
